# Any OpenAI-compatible provider. Free options:
# Groq:       https://api.groq.com/openai/v1  model: llama-3.3-70b-versatile
# Gemini:     https://generativelanguage.googleapis.com/v1beta/openai  model: gemini-2.0-flash
# OpenRouter: https://openrouter.ai/api/v1   model: meta-llama/llama-3.3-70b-instruct:free
LLM_BASE_URL=https://api.groq.com/openai/v1
LLM_API_KEY=
LLM_MODEL=openai/gpt-oss-120b
# Empty LLM_API_KEY => offline MOCK summarizer (pipeline still runs, summaries are placeholders)
POLL_SECONDS=120
# First run: use ~45 so earlier filings are picked up; lower it (3) for steady-state
LOOKBACK_DAYS=45
# Comma-separated name fragments; empty = all companies
WATCHLIST="HDFC Bank,Tata Motors,Infosys,Sun Pharma,Reliance,Larsen"
DB_PATH=data/concall.db
# Groq free tier is ~8000 tokens/min: the summarizer paces itself under this budget
LLM_TPM=7000
LLM_MAX_OUT=1200
CHUNK_CHARS=4000
# set SOURCES=nse to skip BSE while it returns 403
SOURCES=nse,bse
# Optional: query NSE per symbol (more reliable than the global feed), e.g. SYMBOLS=TCS,INFY,HDFCBANK
SYMBOLS=
